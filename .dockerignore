# Allowlist: everything is excluded and only the sources needed to build are let in.
# This way a new file with secrets (.env, keys, fixtures) never reaches the build context.
# Generated files (output.css, *_templ.go) are left out and rebuilt inside the build.
*
!go.mod
!go.sum
!package.json
!package-lock.json
!cmd/**/*.go
!internal/**/*.go
!internal/**/*.templ
!migrations/*.go
!migrations/*.sql
!static/embed.go
!static/css/input.css
**/*_templ.go
