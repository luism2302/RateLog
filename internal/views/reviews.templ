package views

import (
	"strconv"

	"github.com/luism2302/RateLog/internal/data"
	"github.com/luism2302/RateLog/internal/validator"
)

templ ReviewPage(user *data.User, game *data.Game, values ReviewFormValues, isEdit bool, v *validator.Validator) {
	@Base(user) {
		<div class="flex-1 flex items-center justify-center bg-base-200 px-4 py-12">
			@CreateReviewForm(game, values, isEdit, v)
		</div>
	}
}

templ MyReviewsPage(user *data.User, reviews []data.GameReview) {
	@Base(user) {
		<section class="flex-1 bg-base-200 px-4 py-12">
			<div class="mx-auto w-full max-w-6xl">
				<h1 class="text-3xl font-bold tracking-tight">My Reviews</h1>
				<p class="mt-2 text-sm text-base-content/60">Everything you've rated and reviewed.</p>
				<ul role="list" class="mt-8 grid grid-cols-1 gap-4 sm:gap-5 lg:grid-cols-2">
					for _, review := range reviews {
						<li>
							<article class="card h-full overflow-hidden bg-base-100 shadow-xl sm:card-side">
								<figure class="relative aspect-[3/1] w-full shrink-0 bg-base-300 sm:aspect-auto sm:w-40 sm:max-h-56 sm:min-h-40 md:w-48">
									<img src={ review.Game.BackgroundImage } alt="" loading="lazy" class="absolute inset-0 h-full w-full object-cover object-center"/>
								</figure>
								<div class="card-body min-w-0 gap-3 p-5">
									<header class="flex flex-col gap-1.5">
										<h2 class="text-lg font-bold tracking-tight leading-snug text-balance line-clamp-2">{ review.Game.Name }</h2>
										<div class="flex items-center gap-2">
											<div role="img" aria-label={ "Rated " + strconv.Itoa(review.Review.Rating) + " out of 5" } class="rating rating-sm gap-0.5">
												<div aria-hidden="true" aria-current?={ review.Review.Rating == 1 } class="mask mask-star-2 bg-accent"></div>
												<div aria-hidden="true" aria-current?={ review.Review.Rating == 2 } class="mask mask-star-2 bg-accent"></div>
												<div aria-hidden="true" aria-current?={ review.Review.Rating == 3 } class="mask mask-star-2 bg-accent"></div>
												<div aria-hidden="true" aria-current?={ review.Review.Rating == 4 } class="mask mask-star-2 bg-accent"></div>
												<div aria-hidden="true" aria-current?={ review.Review.Rating == 5 } class="mask mask-star-2 bg-accent"></div>
											</div>
											<span aria-hidden="true" class="text-sm font-medium tabular-nums">{ strconv.Itoa(review.Review.Rating) }/5</span>
										</div>
									</header>
									<p class="whitespace-pre-line break-words leading-relaxed text-base-content/80">{ review.Review.Body }</p>
									<p class="mt-auto flex flex-wrap items-center gap-x-2 gap-y-1 pt-1 text-sm text-base-content/60 tabular-nums">
										<span>Reviewed <time datetime={ review.Review.UpdatedAt.Format("2006-01-02") }>{ review.Review.UpdatedAt.Format("Jan 2, 2006") }</time></span>
									</p>
								</div>
							</article>
						</li>
					}
				</ul>
			</div>
		</section>
	}
}

templ CreateReviewForm(game *data.Game, values ReviewFormValues, isEdit bool, v *validator.Validator) {
	if msg := v.GetError("form"); msg != "" {
		<p id="form-error" class="text-error text-xs text-center">{ msg }</p>
	}
	<form method="POST" action={ templ.URL("/my_games/" + strconv.Itoa(game.ID) + "/review") } novalidate class="card w-full max-w-lg overflow-hidden bg-base-100 shadow-xl">
		<figure class="relative aspect-[2/1] w-full bg-base-300">
			<img src={ game.BackgroundImage } alt={ "Cover art for " + game.Name } class="absolute inset-0 h-full w-full object-cover object-center"/>
			<div aria-hidden="true" class="absolute inset-x-0 bottom-0 h-1/3 bg-gradient-to-t from-base-100 to-transparent"></div>
		</figure>
		<div class="card-body gap-6">
			<div class="text-center">
				if isEdit {
					<p class="text-xs font-semibold uppercase tracking-wider text-primary">Edit your review</p>
				} else {
					<p class="text-xs font-semibold uppercase tracking-wider text-primary">Rate and review</p>
				}
				<h1 class="mt-1 text-2xl font-bold tracking-tight text-balance">{ game.Name }</h1>
				<p class="mt-2 flex flex-wrap items-center justify-center gap-x-2 gap-y-1 text-sm text-base-content/60">
					<span>Released <time datetime={ game.Released.Format("2006-01-02") }>{ game.Released.Format("2006") }</time></span>
				</p>
			</div>
			<div class="flex flex-col items-center gap-1.5">
				@StarScore(values.Rating)
				if msg :=  v.GetError("rating"); msg  != "" {
					<p id="rating-error" class="text-error text-xs text-center">{ msg }</p>
				}
			</div>
			<div class="flex flex-col gap-1.5">
				<label for="body" class="text-sm font-medium">Your review</label>
				<textarea id="body" name="body" rows="6" placeholder={ "What did you like about " + game.Name + "? What could be better?" } class="textarea w-full min-h-36 leading-relaxed">{ values.Body }</textarea>
				if msg :=  v.GetError("body"); msg  != "" {
					<p id="body-error" class="text-error text-xs">{ msg }</p>
				}
			</div>
			<div class="flex flex-col-reverse gap-2 sm:flex-row sm:justify-end">
				<a href="/my_games" class="btn btn-ghost">Cancel</a>
				if isEdit {
					<button type="submit" class="btn btn-primary">Save changes</button>
				} else {
					<button type="submit" class="btn btn-primary">Submit review</button>
				}
			</div>
		</div>
	</form>
}

templ StarScore(rating int) {
	<fieldset class="flex flex-col items-center gap-2">
		<legend class="mb-2 w-full text-center text-sm font-medium">Your rating</legend>
		<div class="rating rating-lg gap-1 rounded-field p-1 has-focus-visible:outline-2 has-focus-visible:outline-offset-2 has-focus-visible:outline-primary">
			<input type="radio" name="rating" value="1" aria-label="1 star" checked?={ rating == 1 } required class="mask mask-star-2 bg-accent"/>
			<input type="radio" name="rating" value="2" aria-label="2 star" checked?={ rating == 2 } required class="mask mask-star-2 bg-accent"/>
			<input type="radio" name="rating" value="3" aria-label="3 star" checked?={ rating == 3 } required class="mask mask-star-2 bg-accent"/>
			<input type="radio" name="rating" value="4" aria-label="4 star" checked?={ rating == 4 } required class="mask mask-star-2 bg-accent"/>
			<input type="radio" name="rating" value="5" aria-label="5 star" checked?={ rating == 5 } required class="mask mask-star-2 bg-accent"/>
		</div>
		<p class="text-xs text-base-content/60">Choose from 1 to 5 stars.</p>
	</fieldset>
}
