package views

import (
	"fmt"
	"strconv"
	"time"

	"github.com/luism2302/RateLog/internal/data"
	"github.com/luism2302/RateLog/internal/validator"
)

templ SearchGamePage(games []data.Game, user *data.User, v *validator.Validator) {
	@Base(user) {
		<section class="flex-1 bg-base-200 px-4 py-12">
			<div class="mx-auto w-full max-w-2xl">
				<h1 class="text-3xl font-bold tracking-tight text-center">Search games</h1>
				<p class="mt-2 text-sm text-base-content/60 text-center">Find a game by its title.</p>
				<form method="GET" action="/search_game" role="search" class="mt-8">
					<div class="join w-full shadow-xl">
						<label for="title" class="input join-item w-full">
							<span class="sr-only">Game title</span>
							<svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" class="h-5 w-5 shrink-0 stroke-current opacity-50"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-4.35-4.35M17 10.5a6.5 6.5 0 11-13 0 6.5 6.5 0 0113 0z"></path></svg>
							<input id="title" type="search" name="title" placeholder="e.g. The Legend of Zelda" autocomplete="off" maxlength="100" required class="grow"/>
						</label>
						<button type="submit" class="btn btn-primary join-item">Search</button>
					</div>
				</form>
				<div class="mt-10">
					if games != nil {
						@GameGrid(games)
					}
				</div>
			</div>
		</section>
	}
}

templ GameGrid(games []data.Game) {
	<ul role="list" class="flex flex-col gap-4">
		for _, game := range games {
			@GameCard(game)
		}
	</ul>
}

templ GameCard(game data.Game) {
	<li class="card card-side h-28 sm:h-32 bg-base-100 shadow-xl overflow-hidden">
		<figure class="shrink-0 h-full w-32 sm:w-52 bg-base-300">
			<img src={ game.BackgroundImage } alt="" loading="lazy" class="h-full w-full object-cover object-center"/>
		</figure>
		<div class="card-body justify-center gap-1 p-4 sm:p-5 min-w-0">
			<h2 class="card-title text-base sm:text-lg font-bold tracking-tight line-clamp-2">{ game.Name }</h2>
			<p class="text-sm text-base-content/60">
				Released <time datetime="" class="tabular-nums">{ fmt.Sprintf(": %s", game.Released.Format(time.DateOnly)) }</time>
			</p>
		</div>
		<form method="POST" action={ templ.URL("/my_games/" + strconv.Itoa(game.ID)) } class="card-actions shrink-0 items-center pr-4 sm:pr-5">
			<button type="submit" class="btn btn-primary btn-sm sm:btn-md">
				<svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" class="h-4 w-4 stroke-current"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 5v14M5 12h14"></path></svg>
				<span class="sr-only sm:not-sr-only">Add to My Games</span>
			</button>
		</form>
	</li>
}

templ MyGamesPage(games []data.Game, user *data.User) {
	@Base(user) {
		<section class="flex-1 bg-base-200 px-4 py-12">
			<div class="mx-auto w-full max-w-6xl">
				<h1 class="text-3xl font-bold tracking-tight">My Games</h1>
				<p class="mt-2 text-sm text-base-content/60">Your game library.</p>
				<div class="mt-8">
					if len(games) == 0 {
						@MyGamesEmptyState()
					} else {
						<ul role="list" class="grid grid-cols-2 gap-4 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 sm:gap-5">
							for _, game := range games {
								<!-- isolate + img -z-10: el degradado va en flujo (sin position) para que el panel de
								     confirmación (absolute) tome el li como referencia y lo cubra entero, sin recortes. -->
								<li class="group/tile relative isolate flex aspect-[2/3] flex-col justify-end overflow-hidden rounded-box bg-base-300 shadow-xl">
									<img src={ game.BackgroundImage } alt="" loading="lazy" class="absolute inset-0 -z-10 h-full w-full object-cover object-center"/>
									<div class="bg-gradient-to-t from-neutral via-neutral/70 to-transparent p-3 pt-12 text-neutral-content">
										<h2 class="text-sm sm:text-base font-bold tracking-tight leading-snug line-clamp-2">{ game.Name }</h2>
										<div class="mt-2 flex items-center gap-1.5">
											<a href={ templ.URL("/my_games/" + strconv.Itoa(game.ID) + "/review") } class="btn btn-primary btn-xs sm:btn-sm min-w-0 flex-1 gap-1 shadow-none focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-neutral-content group-has-[details[open]]/tile:invisible">
												<svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="h-3.5 w-3.5 shrink-0 sm:h-4 sm:w-4"><path d="M12 2.5l2.94 5.96 6.56.95-4.75 4.63 1.12 6.54L12 17.5l-5.87 3.08 1.12-6.54L2.5 9.41l6.56-.95L12 2.5z"></path></svg>
												<span class="truncate">Rate and review</span>
											</a>
											<!-- Quitar: disparador solo-icono discreto; al abrirse, el propio summary pasa a ser "Cancel"
											     dentro del panel. name="remove-game" (no es campo de formulario): solo un panel abierto a la vez. -->
											<details name="remove-game" class="group shrink-0">
												<summary class="btn btn-ghost btn-square btn-xs sm:btn-sm list-none border-neutral-content/30 text-neutral-content shadow-none hover:text-error focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-neutral-content [&::-webkit-details-marker]:hidden group-open:absolute group-open:inset-x-3 group-open:bottom-3 group-open:z-20 group-open:w-auto group-open:border-transparent group-open:hover:text-base-content">
													<svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" class="h-3.5 w-3.5 stroke-current sm:h-4 sm:w-4 group-open:hidden"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 7h16M10 11v6M14 11v6M5 7l1 12a2 2 0 002 2h8a2 2 0 002-2l1-12M9 7V4a1 1 0 011-1h4a1 1 0 011 1v3"></path></svg>
													<span class="sr-only group-open:hidden">Remove from My Games</span>
													<span class="hidden group-open:inline">Cancel</span>
												</summary>
												<div class="absolute inset-0 z-10 flex flex-col justify-end gap-2 bg-neutral/95 p-3 pb-11 text-neutral-content sm:pb-13">
													<p class="text-sm font-bold tracking-tight leading-snug">Remove from My Games?</p>
													<p class="text-xs leading-snug text-neutral-content/80">Your rating and review of this game will be deleted too.</p>
													<form method="POST" action={ templ.URL("/my_games/" + strconv.Itoa(game.ID) + "/delete") } class="mt-1">
														<button type="submit" class="btn btn-error btn-xs sm:btn-sm w-full shadow-none focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-neutral-content">
															Remove
														</button>
													</form>
												</div>
											</details>
										</div>
									</div>
								</li>
							}
						</ul>
					}
				</div>
			</div>
		</section>
	}
}

// NoResultsState: búsqueda hecha pero sin resultados (excepción "sin resultados" a "Estados vacíos").
// Sin btn-primary: el buscador ya está en la página.
templ NoResultsState() {
	<div class="card mx-auto w-full max-w-lg bg-base-100 shadow-xl">
		<div class="card-body items-center gap-3 py-12 text-center">
			<svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" class="h-12 w-12 stroke-current text-base-content/40"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M21 21l-4.35-4.35M17 10.5a6.5 6.5 0 11-13 0 6.5 6.5 0 0113 0z"></path></svg>
			<h2 class="text-xl font-bold tracking-tight">No games found</h2>
			<p class="text-sm text-base-content/60 text-balance">Check the spelling or try a shorter title.</p>
			<a href="/search_game" class="link link-primary mt-1 text-sm font-medium rounded-field focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary">Clear search</a>
		</div>
	</div>
}

// MyGamesEmptyState: My Games sin juegos. Se renderiza en lugar del <ul> (nunca un <ul> vacío).
templ MyGamesEmptyState() {
	<div class="card mx-auto w-full max-w-lg bg-base-100 shadow-xl">
		<div class="card-body items-center gap-3 py-12 text-center">
			<svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" class="h-12 w-12 stroke-current text-base-content/40"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"></path></svg>
			<h2 class="text-xl font-bold tracking-tight">No games yet</h2>
			<p class="text-sm text-base-content/60 text-balance">Search for a game and add it to your library to rate and review it.</p>
			<a href="/search_game" class="btn btn-primary mt-2">
				<svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" class="h-4 w-4 stroke-current"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-4.35-4.35M17 10.5a6.5 6.5 0 11-13 0 6.5 6.5 0 0113 0z"></path></svg>
				Search games
			</a>
		</div>
	</div>
}

// InMyGamesLink: maqueta del estado "In My Games" para GameCard; sustituye al <form> de Add cuando
// el juego ya está en la colección. Envuelto igual que el <form> de Add para conservar la alineación.
// TODO (lógica): añadir el nombre del juego en sr-only (ver informe del diseñador) y pasar `game` como parámetro.
templ InMyGamesLink() {
	<div class="card-actions shrink-0 items-center pr-4 sm:pr-5">
		<a href="/my_games" class="btn btn-ghost btn-sm">
			<svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" class="h-4 w-4 stroke-current"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
			<span class="sr-only sm:not-sr-only">In My Games</span>
		</a>
	</div>
}
