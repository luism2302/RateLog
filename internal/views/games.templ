package views

import (
	"fmt"
	"time"

	"github.com/luism2302/RateLog/internal/data"
)

templ SearchGamePage(games []data.Game, user *data.User) {
	@Base(user) {
		<section class="flex-1 bg-base-200 px-4 py-12">
			<div class="mx-auto w-full max-w-2xl">
				<h1 class="text-3xl font-bold tracking-tight text-center">Search Game</h1>
				<p class="mt-2 text-sm text-base-content/60 text-center">Find a game by its title.</p>
				<form method="GET" action="/search_game" role="search" class="mt-8">
					<label for="title" class="sr-only">Game title</label>
					<div class="join w-full shadow-xl">
						<label class="input join-item w-full">
							<svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" class="h-5 w-5 stroke-current opacity-50"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-4.35-4.35M17 10.5a6.5 6.5 0 11-13 0 6.5 6.5 0 0113 0z"></path></svg>
							<input id="title" type="search" name="title" placeholder="e.g. The Legend of Zelda" autocomplete="off" required class="grow"/>
						</label>
						<button type="submit" class="btn btn-primary join-item">Search</button>
					</div>
				</form>
				<div class="mt-10">
					if games != nil {
						@GameGrid(games)
					}
				</div>
			</div>
		</section>
	}
}

templ GameGrid(games []data.Game) {
	<ul class="flex flex-col gap-4">
		for _, game := range games {
			@GameCard(game)
		}
	</ul>
}

templ GameCard(game data.Game) {
	<li class="card card-side h-28 sm:h-32 bg-base-100 shadow-xl overflow-hidden transition hover:-translate-y-0.5 hover:shadow-2xl">
		<figure class="shrink-0 h-full w-32 sm:w-52 bg-base-300">
			<img src={ game.BackgroundImage } alt="" loading="lazy" class="h-full w-full object-cover object-center"/>
		</figure>
		<div class="card-body justify-center gap-1 p-4 sm:p-5 min-w-0">
			<h2 class="card-title text-base sm:text-lg font-bold tracking-tight line-clamp-2">{ game.Name }</h2>
			<p class="text-sm text-base-content/60">
				Released <time datetime="">{ fmt.Sprintf(": %s", game.Released.Format(time.DateOnly)) }</time>
			</p>
		</div>
		<form method="POST" action="/add_game" class="card-actions shrink-0 items-center pr-4 sm:pr-5">
			<button type="submit" aria-label="Add to My Games" class="btn btn-primary btn-sm sm:btn-md">
				<input type="hidden" name="id" value={ game.ID }/>
				<input type="hidden" name="name" value={ game.Name }/>
				<input type="hidden" name="released" value={ game.Released.String() }/>
				<input type="hidden" name="backgroundImage" value={ game.BackgroundImage }/>
				<input type="hidden" name="added" value={ game.Added }/>
				<svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" class="h-4 w-4 stroke-current"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 5v14M5 12h14"></path></svg>
				<span class="hidden sm:inline">Add to My Games</span>
			</button>
		</form>
	</li>
}
