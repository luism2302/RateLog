package views

import(

	"github.com/luism2302/RateLog/internal/validator"
)



templ LoginPage(values LoginFormValues, v *validator.Validator) {
     @BaseLogin(){
          <div class="flex-1 flex items-center justify-center bg-base-200 px-4 py-12">
               @LoginForm(values, v)
          </div>
     }

}

templ LoginForm(values LoginFormValues, v *validator.Validator) {
     <form method="POST" action="/login" class="card w-full max-w-sm bg-base-100 shadow-xl rounded-2xl">
          <div class="card-body gap-5">
               <div class="text-center">
                    <h1 class="text-2xl font-bold tracking-tight">Welcome back</h1>
                    <p class="text-sm text-base-content/60 mt-1">Log in to your Rate Log account</p>
               </div>

               <div class="flex flex-col gap-1.5">
                    <label for="email" class="text-sm font-medium">Email</label>
                    <label class="input w-full">
                         <svg class="h-4 w-4 opacity-50" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg>
                         <input id="email" type="email" name="email" placeholder="you@example.com" value={ values.Email }/>
                    </label>
                    if msg :=  v.GetError("email"); msg  != "" {
                         <p class="text-error text-xs">{ msg }</p>
                    }
               </div>

               <div class="flex flex-col gap-1.5">
                    <label for="password" class="text-sm font-medium">Password</label>
                    <label class="input w-full">
                         <svg class="h-4 w-4 opacity-50" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path></svg>
                         <input id="password" name="password" type="password" placeholder="••••••••"/>
                    </label>
                    if msg :=  v.GetError("password"); msg  != "" {
                         <p class="text-error text-xs">{ msg }</p>
                    }
               </div>

               <button type="submit" class="btn btn-primary w-full mt-2">Log in</button>

               <p class="text-center text-sm text-base-content/60">
                    Don't have an account?
                    <a href="/signup" class="link link-hover link-primary font-medium">Sign up</a>
               </p>
          </div>
     </form>
}

templ SignupPage(values SignupFormValues, v *validator.Validator) {
     @BaseLogin(){
          <div class="flex-1 flex items-center justify-center bg-base-200 px-4 py-12">
               @SignupForm(values, v)
          </div>
     }
}
templ SignupForm(values SignupFormValues, v *validator.Validator) {
     <form method="POST" action="/signup" class="card w-full max-w-sm bg-base-100 shadow-xl rounded-2xl">
          <div class="card-body gap-5">
               <div class="text-center">
                    <h1 class="text-2xl font-bold tracking-tight">Create your account</h1>
                    <p class="text-sm text-base-content/60 mt-1">Join Rate Log and start rating games</p>
               </div>

               <div class="flex flex-col gap-1.5">
                    <label for="name" class="text-sm font-medium">Username</label>
                    <label class="input w-full">
                         <svg class="h-4 w-4 opacity-50" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path></svg>
                         <input id="name" type="text" name="name" placeholder="yourname" autocomplete="username" value={ values.Name }/>
                    </label>
                    if msg :=  v.GetError("name"); msg  != "" {
                         <p class="text-error text-xs">{ msg }</p>
                    }
               </div>

               <div class="flex flex-col gap-1.5">
                    <label for="email" class="text-sm font-medium">Email</label>
                    <label class="input w-full">
                         <svg class="h-4 w-4 opacity-50" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg>
                         <input id="email" type="email" name="email" placeholder="you@example.com" value={ values.Email }/>
                    </label>
                    if msg :=  v.GetError("email"); msg  != "" {
                         <p class="text-error text-xs">{ msg }</p>
                    }
               </div>

               <div class="flex flex-col gap-1.5">
                    <label for="password" class="text-sm font-medium">Password</label>
                    <label class="input w-full">
                         <svg class="h-4 w-4 opacity-50" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path></svg>
                         <input id="password" type="password" name="password" placeholder="••••••••" value={ values.Password }/>
                    </label>
                    if msg :=  v.GetError("password"); msg  != "" {
                         <p class="text-error text-xs">{ msg }</p>
                    }
               </div>

               <div class="flex flex-col gap-1.5">
                    <label for="confirmPassword" class="text-sm font-medium">Confirm Password</label>
                    <label class="input w-full">
                         <svg class="h-4 w-4 opacity-50" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path></svg>
                         <input id="confirmPassword" type="password" name="confirmPassword" placeholder="••••••••" value={ values.ConfirmPassword }/>
                    </label>
                    if msg :=  v.GetError("confirmPassword"); msg  != "" {
                         <p class="text-error text-xs">{ msg }</p>
                    }
               </div>

               <button type="submit" class="btn btn-primary w-full mt-2">Sign up</button>

               <p class="text-center text-sm text-base-content/60">
                    Already have an account?
                    <a href="/login" class="link link-hover link-primary font-medium">Log in</a>
               </p>
          </div>
     </form>
}
