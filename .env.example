# Copy this file to .env and fill it in: cp .env.example .env
# Generate each password with: openssl rand -hex 24
# (hex only: passwords go inside the connection URL, and characters like @ / : would break it)
# Write NAME=value with no spaces around the =

# RAWG API key (free): https://rawg.io/apidocs
RAWG_API_KEY=

# Postgres superuser (administration only; the app doesn't use it)
DB_USER=ratelog
DB_PASSWORD=
DB_NAME=ratelog

# Roles created by db/init/01-roles.sh the first time Postgres starts
RATELOG_OWNER_PASSWORD=
RATELOG_APP_PASSWORD=

# Optional: local port where the app is published (default 8000)
# RATELOG_PORT=8000
