# Copia este archivo como .env y rellénalo: cp .env.example .env
# Genera cada contraseña con: openssl rand -hex 24
# (solo hexadecimal: van dentro de la URL de conexión y caracteres como @ / : la romperían)
# Escribe NOMBRE=valor sin espacios alrededor del =

# Clave de la API de RAWG: https://rawg.io/apidocs
RAWG_API_KEY=

# Superusuario de Postgres (solo administra; la app no lo usa)
DB_USER=ratelog
DB_PASSWORD=
DB_NAME=ratelog

# Roles que crea db/init/01-roles.sh la primera vez que arranca Postgres
RATELOG_OWNER_PASSWORD=
RATELOG_APP_PASSWORD=

# Opcional: puerto local donde se publica la app (por defecto 8000)
# RATELOG_PORT=8000
